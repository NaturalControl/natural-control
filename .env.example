# Natural Control env template. Copy to .env.local and fill in. Never commit real values.
# The agent worker and the web client's token route both read these.

# --- LiveKit Cloud (voice rooms + LiveKit Inference for STT, voice LLM, TTS) ---
# Where: cloud.livekit.io > natural-control > Settings > API Keys > Create key.
# The secret is shown once.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- OpenRouter (model behind Hermes) ---
# Where: openrouter.ai > Settings > Keys. Set a credit limit on the key.
OPENROUTER_API_KEY=
# Default DeepSeek V4.1 Flash; comparison z-ai/glm-5.3-flash (spike 4).
AGENT_MODEL=deepseek/deepseek-v4.1-flash

# --- Composio (Gmail + Calendar via managed auth; no Google Cloud project needed) ---
# Where: platform.composio.dev > Settings > API Keys. Connect a TEST Gmail account.
COMPOSIO_API_KEY=
# Not secret: the Composio user the test account is connected under.
COMPOSIO_USER_ID=natural-control-dev

# --- Optional overrides for LiveKit Inference voice models (spike 5) ---
# VOICE_STT=deepgram/flux-general-en
# VOICE_LLM=openai/gpt-oss-120b
# VOICE_TTS=cartesia/sonic-3

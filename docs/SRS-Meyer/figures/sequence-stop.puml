@startuml sequence-stop
skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam sequenceMessageAlign left
skinparam ParticipantBackgroundColor #E8F4EF
skinparam ParticipantBorderColor #1D7A5C
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #999999
hide footbox

actor User as user
participant "Voice\ninterface" as voice
participant "Task\nmanager" as tm
participant "Task\nhistory" as hist
participant "AI agent" as agent
participant "Action\ngate" as gate
participant "Outcome\nverification" as verify
participant "Account\ntools" as accounts #F2F2F0

note over tm : Executing: an approved\n"create event" call is in flight
gate -> accounts : create event (in flight)

user -> voice : "Stop working" (or stop key)
voice -> tm : stop request (fixed rule,\nnot model interpretation)
voice -> user : "Stopping." (within STOP_ACK_TIME)
hnote over tm : Stopping
tm -> hist : record stop request
tm -> gate : refuse further consequential\ncalls for this task
tm -> agent : interrupt

accounts --> gate : created
gate -> verify : check outcome
verify -> accounts : read event back
accounts --> verify : event found
verify --> gate : verified
gate --> tm : in-flight action settled: verified

agent -> gate : next tool call
gate --> agent : refused: task stopping
agent --> tm : interrupted

hnote over tm : Stopped
tm -> hist : record stop, completed\nand uncertain actions
tm -> voice : confirmed stop and summary
voice -> user : "Stopped. The event was already\nadded; nothing else will run."
@enduml

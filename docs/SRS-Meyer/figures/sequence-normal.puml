@startuml sequence-normal
skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam sequenceMessageAlign left
skinparam ParticipantBackgroundColor #E8F4EF
skinparam ParticipantBorderColor #1D7A5C
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #999999
hide footbox

actor User as user
participant "Voice\ninterface" as voice
participant "Task\nmanager" as tm
participant "Task\nhistory" as hist
participant "AI agent" as agent
participant "Action\ngate" as gate
participant "Outcome\nverification" as verify
participant "Browser\nUse" as browser #F2F2F0
participant "Account\ntools" as accounts #F2F2F0

user -> voice : "Add the meetup on this\npage to my calendar"
voice -> tm : new task
tm -> hist : record task
hnote over tm : Working
tm -> agent : start task
voice -> user : "On it. Reading the page."

agent -> gate : read page
gate -> browser : read-only call, allowed
browser --> gate : page content
gate --> agent : content (screened for\ninjected instructions)

agent -> gate : create event (title, time, place)
gate -> tm : approval request with exact details
hnote over tm : AwaitingApproval
tm -> voice : read back details
voice -> user : "Create Toronto AI Meetup,\nThursday 7 to 9 pm, at MaRS?"
user -> voice : "Yes"
voice -> tm : explicit yes
tm -> hist : record approval
hnote over tm : Executing
tm -> gate : approved

gate -> accounts : create event (unique action ID)
accounts --> gate : created
gate -> verify : check outcome
verify -> accounts : read event back
accounts --> verify : event found
verify --> gate : verified
gate --> agent : result: verified
tm -> hist : record verified outcome
hnote over tm : Working

agent -> tm : task complete
hnote over tm : Done
tm -> hist : record completion
tm -> voice : verified result
voice -> user : "Done. It's on your calendar\nfor Thursday at 7."
@enduml
